# dapkel — greenish-bluish house style for the Kelpie analysis package.
#
# Values collected from the dapkel modules (font.size 30, 16x10 line/dist
# figures, in-pointing ticks) and unified onto a green->blue palette. The
# earlier ad-hoc colormaps (viridis / inferno / PuBuGn_r) are superseded here
# by a single green-blue `image.cmap`; the exact palette is provisional and
# will be pinned down later.
#
# Square heatmaps (hitmap, DCR, cross-talk) set their own figsize in code, so
# figure.figsize below only drives the line/distribution/histogram plots.
#
# Override in a script with `komorebi_mpl.use("<other>")` (that always wins).
#
# Every komorebi_mpl style declares the same parameters in the same section
# order; only the values differ.

# ── Fonts ───────────────────────────────────────────────────────────────────
# font.size is the base; the slots below are deliberately smaller so legends,
# labels, ticks and annotations don't overwhelm the data. Free-floating text
# boxes have no rcParam of their own, so code should use matplotlib *relative*
# sizes ('small', 'x-small', ...) — fractions of this base, so they follow the
# style too.
font.size: 30
axes.titlesize: 28
axes.labelsize: 26
xtick.labelsize: 22
ytick.labelsize: 22
legend.fontsize: 20
figure.titlesize: 30
font.family: sans-serif
font.sans-serif: sans-serif, Arial, Liberation Sans, DejaVu Sans, Bitstream Vera Sans

# ── Figure (line / distribution plots; square maps override in code) ─────────
figure.figsize: 16, 10
figure.frameon: False
figure.subplot.top: 0.94
figure.subplot.right: 0.93
figure.facecolor: "#FFFFFF"
savefig.facecolor: "#FFFFFF"
# figure.dpi: 100
# savefig.dpi: 300
# savefig.bbox: tight

# ── Axes ────────────────────────────────────────────────────────────────────
axes.facecolor: "#FFFFFF"
axes.edgecolor: "#2F3A3A"
axes.linewidth: 1.5
axes.titlepad: 12
axes.labelpad: 8
axes.spines.top: True
axes.spines.right: True
axes.grid: True
axes.grid.which: both

# ── Ticks — inward, with minor ticks ────────────────────────────────────────
xtick.top: True
ytick.right: True
xtick.direction: in
ytick.direction: in
xtick.minor.visible: True
ytick.minor.visible: True
xtick.major.size: 10
ytick.major.size: 10
xtick.major.width: 2
ytick.major.width: 2
xtick.minor.size: 5
ytick.minor.size: 5
xtick.minor.width: 1.2
ytick.minor.width: 1.2

# ── Grid (used by the plots that call ax.grid; heatmaps do not) ──────────────
grid.color: "#B7C9C9"
grid.linestyle: --
grid.linewidth: 0.8
grid.alpha: 0.6

# ── Legend ──────────────────────────────────────────────────────────────────
legend.frameon: True
legend.framealpha: 0.9
legend.facecolor: "#E8F0F0"
legend.edgecolor: "#B7C9C9"
legend.numpoints: 1
legend.scatterpoints: 1
legend.labelspacing: 0.3

# ── Lines & markers ─────────────────────────────────────────────────────────
lines.linewidth: 2.5
lines.markersize: 7
lines.solid_capstyle: round
errorbar.capsize: 4

# ── Box plots ─ matplotlib defaults these to literal black, which is
# invisible on the dark styles; median/mean already follow the cycle (C1/C2)
boxplot.boxprops.color: "#1E2A2A"
boxplot.whiskerprops.color: "#1E2A2A"
boxplot.capprops.color: "#1E2A2A"
boxplot.flierprops.color: "#1E2A2A"
boxplot.flierprops.markeredgecolor: "#1E2A2A"

# ── Text boxes — mirror the legend, so a text box and a legend match ────────
patch.facecolor: "#E8F0F0"
patch.edgecolor: "#B7C9C9"

# ── Colors ──────────────────────────────────────────────────────────────────
# Green -> blue palette (lines, bars) and heatmap colormap
axes.prop_cycle: cycler('color', ['2A6F97', '52B788', '168AAD', '2A9D8F', '76C893', '287271'])
image.cmap: YlGnBu
# Dark green-grey text — softer than pure black
text.color: "#1E2A2A"
axes.labelcolor: "#1E2A2A"
xtick.color: "#1E2A2A"
ytick.color: "#1E2A2A"
