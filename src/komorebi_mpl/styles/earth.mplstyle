# earth — warm parchment background with a terracotta/rust/olive palette.
# Cozy and natural; a warmer alternative to sci_faded.
#
# Palette:
#   9B2335  terracotta
#   D4622A  rust
#   5E7A28  olive
#   8B5E3C  bark
#   C9984A  sandy gold
#   4A7462  sage
#
# Background: parchment #F5ECD7 (figure) over a slightly deeper #EDE0C8 (axes).
#
# Every komorebi_mpl style declares the same parameters in the same section
# order; only the values differ.

# ── Fonts ───────────────────────────────────────────────────────────────────
# font.size is the base; the slots below are deliberately smaller so legends,
# labels, ticks and annotations don't overwhelm the data. Free-floating text
# boxes have no rcParam of their own, so code should use matplotlib *relative*
# sizes ('small', 'x-small', ...) — fractions of this base, so they follow the
# style too.
font.size: 30
axes.titlesize: 28
axes.labelsize: 26
xtick.labelsize: 22
ytick.labelsize: 22
legend.fontsize: 20
figure.titlesize: 30
font.family: sans-serif
font.sans-serif: sans-serif, Arial, Liberation Sans, DejaVu Sans, Bitstream Vera Sans

# ── Figure ──────────────────────────────────────────────────────────────────
figure.figsize: 16, 10
figure.frameon: False
figure.subplot.top: 0.94
figure.subplot.right: 0.93
figure.facecolor: "#F5ECD7"
savefig.facecolor: "#F5ECD7"
# figure.dpi: 100
# savefig.dpi: 300
# savefig.bbox: tight

# ── Axes ────────────────────────────────────────────────────────────────────
axes.facecolor: "#EDE0C8"
axes.edgecolor: "#A08060"
axes.linewidth: 1.5
axes.titlepad: 12
axes.labelpad: 8
axes.spines.top: True
axes.spines.right: True
axes.grid: True
axes.grid.which: both

# ── Ticks ───────────────────────────────────────────────────────────────────
xtick.top: True
ytick.right: True
xtick.direction: in
ytick.direction: in
xtick.minor.visible: True
ytick.minor.visible: True
xtick.major.size: 10
ytick.major.size: 10
xtick.major.width: 2
ytick.major.width: 2
xtick.minor.size: 5
ytick.minor.size: 5
xtick.minor.width: 1.2
ytick.minor.width: 1.2

# ── Grid — warm, faint tan ──────────────────────────────────────────────────
grid.color: "#C8B898"
grid.linestyle: --
grid.linewidth: 0.9
grid.alpha: 0.45

# ── Legend ──────────────────────────────────────────────────────────────────
legend.frameon: True
legend.framealpha: 0.9
legend.facecolor: "#E0D0B0"
legend.edgecolor: "#A08060"
legend.numpoints: 1
legend.scatterpoints: 1
legend.labelspacing: 0.3

# ── Lines & markers ─────────────────────────────────────────────────────────
lines.linewidth: 2
lines.markersize: 6
lines.solid_capstyle: round
errorbar.capsize: 4

# ── Box plots ─ matplotlib defaults these to literal black, which is
# invisible on the dark styles; median/mean already follow the cycle (C1/C2)
boxplot.boxprops.color: "#4A3020"
boxplot.whiskerprops.color: "#4A3020"
boxplot.capprops.color: "#4A3020"
boxplot.flierprops.color: "#4A3020"
boxplot.flierprops.markeredgecolor: "#4A3020"

# ── Text boxes — mirror the legend, so a text box and a legend match ────────
patch.facecolor: "#E0D0B0"
patch.edgecolor: "#A08060"

# ── Colors ──────────────────────────────────────────────────────────────────
# Earth tones: terracotta, rust, olive, bark, sandy gold, sage
axes.prop_cycle: cycler('color', ['9B2335', 'D4622A', '5E7A28', '8B5E3C', 'C9984A', '4A7462'])
image.cmap: YlOrBr
# Dark warm brown text
text.color: "#2C1810"
axes.labelcolor: "#2C1810"
xtick.color: "#4A3020"
ytick.color: "#4A3020"
