# sci_faded — sun-faded-paper look: soft, slightly desaturated colors on a
# warm off-white background. A gentler alternative to sci_pure.
#
# Palette:
#   3B5BA9  faded blue
#   C44536  faded brick
#   4C9F70  faded green
#   E5A823  faded gold
#   7B3E8C  faded plum
#   D17C36  faded ochre
#
# Background: aged paper #F1EBDE, black ink for text and frame.
#
# Every komorebi_mpl style declares the same parameters in the same section
# order; only the values differ.

# ── Fonts ───────────────────────────────────────────────────────────────────
# font.size is the base; the slots below are deliberately smaller so legends,
# labels, ticks and annotations don't overwhelm the data. Free-floating text
# boxes have no rcParam of their own, so code should use matplotlib *relative*
# sizes ('small', 'x-small', ...) — fractions of this base, so they follow the
# style too.
font.size: 30
axes.titlesize: 28
axes.labelsize: 26
xtick.labelsize: 22
ytick.labelsize: 22
legend.fontsize: 20
figure.titlesize: 30
font.family: sans-serif
font.sans-serif: sans-serif, Arial, Liberation Sans, DejaVu Sans, Bitstream Vera Sans

# ── Figure ──────────────────────────────────────────────────────────────────
figure.figsize: 16, 10
figure.frameon: False
figure.subplot.top: 0.94
figure.subplot.right: 0.93
figure.facecolor: "#F1EBDE"
savefig.facecolor: "#F1EBDE"
# figure.dpi: 100
# savefig.dpi: 300
# savefig.bbox: tight

# ── Axes ────────────────────────────────────────────────────────────────────
axes.facecolor: "#F1EBDE"
axes.edgecolor: "black"
axes.linewidth: 1.5
axes.titlepad: 12
axes.labelpad: 8
axes.spines.top: True
axes.spines.right: True
axes.grid: True
axes.grid.which: both

# ── Ticks ───────────────────────────────────────────────────────────────────
xtick.top: True
ytick.right: True
xtick.direction: in
ytick.direction: in
xtick.minor.visible: True
ytick.minor.visible: True
xtick.major.size: 10
ytick.major.size: 10
xtick.major.width: 2
ytick.major.width: 2
xtick.minor.size: 5
ytick.minor.size: 5
xtick.minor.width: 1.2
ytick.minor.width: 1.2

# ── Grid — near-black, kept faint by the low alpha ──────────────────────────
grid.color: "#1A1A1A"
grid.linestyle: --
grid.linewidth: 1
grid.alpha: 0.3

# ── Legend ──────────────────────────────────────────────────────────────────
legend.frameon: True
legend.framealpha: 0.9
legend.facecolor: "#D2CAC1"
legend.edgecolor: "black"
legend.numpoints: 1
legend.scatterpoints: 1
legend.labelspacing: 0.3

# ── Lines & markers ─────────────────────────────────────────────────────────
lines.linewidth: 2
lines.markersize: 6
lines.solid_capstyle: round
errorbar.capsize: 4

# ── Box plots ─ matplotlib defaults these to literal black, which is
# invisible on the dark styles; median/mean already follow the cycle (C1/C2)
boxplot.boxprops.color: "black"
boxplot.whiskerprops.color: "black"
boxplot.capprops.color: "black"
boxplot.flierprops.color: "black"
boxplot.flierprops.markeredgecolor: "black"

# ── Text boxes — mirror the legend, so a text box and a legend match ────────
patch.facecolor: "#D2CAC1"
patch.edgecolor: "black"

# ── Colors ──────────────────────────────────────────────────────────────────
# Soft, slightly desaturated palette (see header)
axes.prop_cycle: cycler('color', ['3B5BA9', 'C44536', '4C9F70', 'E5A823', '7B3E8C', 'D17C36'])
image.cmap: cividis
# Black ink on aged paper
text.color: "black"
axes.labelcolor: "black"
xtick.color: "black"
ytick.color: "black"
