# night_wave — dark background with neon lines; a synthwave vibe.
# Heavily inspired by Dominik Haitz's 'mplcyberpunk'. Pairs with the helpers
# in komorebi_mpl.functions.night_wave_func (glow, gradient fills).
#
# Neon palette:
#   EB67F5  magenta
#   88F7E2  aqua
#   44D492  spring green
#   F5EB67  electric yellow
#   FFA15C  amber
#   FA233E  hot red
#
# Background: bluish dark grey #221D2F.
#
# Every komorebi_mpl style declares the same parameters in the same section
# order; only the values differ.

# ── Fonts ───────────────────────────────────────────────────────────────────
# font.size is the base; the slots below are deliberately smaller so legends,
# labels, ticks and annotations don't overwhelm the data. Free-floating text
# boxes have no rcParam of their own, so code should use matplotlib *relative*
# sizes ('small', 'x-small', ...) — fractions of this base, so they follow the
# style too.
font.size: 30
axes.titlesize: 28
axes.labelsize: 26
xtick.labelsize: 22
ytick.labelsize: 22
legend.fontsize: 20
figure.titlesize: 30
font.family: sans-serif
font.sans-serif: sans-serif, Arial, Liberation Sans, DejaVu Sans, Bitstream Vera Sans

# ── Figure ──────────────────────────────────────────────────────────────────
figure.figsize: 16, 10
figure.frameon: False
figure.subplot.top: 0.94
figure.subplot.right: 0.93
figure.facecolor: "#221D2F"
savefig.facecolor: "#221D2F"
# figure.dpi: 100
# savefig.dpi: 300
# savefig.bbox: tight

# ── Axes ────────────────────────────────────────────────────────────────────
axes.facecolor: "#221D2F"
axes.edgecolor: "#BFBFBF"
axes.linewidth: 1.5
axes.titlepad: 12
axes.labelpad: 8
axes.spines.top: True
axes.spines.right: True
axes.grid: True
axes.grid.which: both

# ── Ticks ───────────────────────────────────────────────────────────────────
xtick.top: True
ytick.right: True
xtick.direction: in
ytick.direction: in
xtick.minor.visible: True
ytick.minor.visible: True
xtick.major.size: 10
ytick.major.size: 10
xtick.major.width: 2
ytick.major.width: 2
xtick.minor.size: 5
ytick.minor.size: 5
xtick.minor.width: 1.2
ytick.minor.width: 1.2

# ── Grid — cool pale blue, faint against the dark background ────────────────
grid.color: "#AAC7DF"
grid.linestyle: --
grid.linewidth: 1
grid.alpha: 0.3

# ── Legend ──────────────────────────────────────────────────────────────────
legend.frameon: True
legend.framealpha: 0.9
legend.facecolor: "#382C47"
legend.edgecolor: "#5E5278"
legend.numpoints: 1
legend.scatterpoints: 1
legend.labelspacing: 0.3

# ── Lines & markers ─────────────────────────────────────────────────────────
lines.linewidth: 2
lines.markersize: 6
lines.solid_capstyle: round
errorbar.capsize: 4

# ── Box plots ─ matplotlib defaults these to literal black, which is
# invisible on the dark styles; median/mean already follow the cycle (C1/C2)
boxplot.boxprops.color: "#F2F2F2"
boxplot.whiskerprops.color: "#F2F2F2"
boxplot.capprops.color: "#F2F2F2"
boxplot.flierprops.color: "#F2F2F2"
boxplot.flierprops.markeredgecolor: "#F2F2F2"

# ── Text boxes — mirror the legend, so a text box and a legend match ────────
patch.facecolor: "#382C47"
patch.edgecolor: "#5E5278"

# ── Colors ──────────────────────────────────────────────────────────────────
# Neon palette (see header)
axes.prop_cycle: cycler('color', ['EB67F5', '88F7E2', '44D492', 'F5EB67', 'FFA15C', 'FA233E'])
image.cmap: plasma
# Near-white text on the dark background
text.color: "#FFFFFF"
axes.labelcolor: "#FFFFFF"
xtick.color: "#F2F2F2"
ytick.color: "#F2F2F2"
