# daplis — house style for the LinoSPAD2 analysis package.
#
# Colors are chosen for colorblindness accessibility and publication quality.
# The 8-color cycle maps onto the recurring roles in the daplis plots:
#   0: rebeccapurple  (#663399) - primary data / histograms
#   1: darkorange     (#FF8C00) - fits / overlaid curves
#   2: teal           (#008080) - single-pixel histograms
#   3: salmon         (#FA8072) - sensor population (full sensor)
#   4: darkslateblue  (#483D8B) - DCR stability
#   5: indianred      (#CD5C5C) - cross-talk error bars (single aggressor)
#   6: darkred        (#8B0000) - cross-talk averages
#   7: black          (#000000) - fit overlays / reference lines
#
# Override in a script with `komorebi_mpl.use("<other>")` (that always wins).
#
# Every komorebi_mpl style declares the same parameters in the same section
# order; only the values differ.

# ── Fonts ───────────────────────────────────────────────────────────────────
# font.size is the base; the slots below are deliberately smaller so legends,
# labels, ticks and annotations don't overwhelm the data. Free-floating text
# boxes have no rcParam of their own, so code should use matplotlib *relative*
# sizes ('small', 'x-small', ...) — fractions of this base, so they follow the
# style too.
font.size: 30
axes.titlesize: 28
axes.labelsize: 26
xtick.labelsize: 22
ytick.labelsize: 22
legend.fontsize: 20
figure.titlesize: 30
font.family: sans-serif
font.sans-serif: sans-serif, Arial, Liberation Sans, DejaVu Sans, Bitstream Vera Sans

# ── Figure ──────────────────────────────────────────────────────────────────
figure.figsize: 16, 10
figure.frameon: False
figure.subplot.top: 0.94
figure.subplot.right: 0.93
figure.facecolor: "#FFFFFF"
savefig.facecolor: "#FFFFFF"
# figure.dpi: 100
# savefig.dpi: 300
# savefig.bbox: tight

# ── Axes ────────────────────────────────────────────────────────────────────
axes.facecolor: "#FFFFFF"
axes.edgecolor: "black"
axes.linewidth: 1.5
axes.titlepad: 12
axes.labelpad: 8
axes.spines.top: True
axes.spines.right: True
axes.grid: True
axes.grid.which: both

# ── Ticks — outward-facing, so they never sit on top of the data ────────────
xtick.top: True
ytick.right: True
xtick.direction: out
ytick.direction: out
xtick.minor.visible: True
ytick.minor.visible: True
xtick.major.size: 10
ytick.major.size: 10
xtick.major.width: 2
ytick.major.width: 2
xtick.minor.size: 5
ytick.minor.size: 5
xtick.minor.width: 1.2
ytick.minor.width: 1.2

# ── Grid — light grey, faint ────────────────────────────────────────────────
grid.color: "#BFBFBF"
grid.linestyle: --
grid.linewidth: 0.8
grid.alpha: 0.25

# ── Legend ──────────────────────────────────────────────────────────────────
legend.frameon: True
legend.framealpha: 0.9
legend.facecolor: "#F0ECF8"
legend.edgecolor: "#663399"
legend.numpoints: 1
legend.scatterpoints: 1
legend.labelspacing: 0.3

# ── Lines & markers ─────────────────────────────────────────────────────────
lines.linewidth: 2.5
lines.markersize: 7
lines.solid_capstyle: round
errorbar.capsize: 4

# ── Box plots ─ matplotlib defaults these to literal black, which is
# invisible on the dark styles; median/mean already follow the cycle (C1/C2)
boxplot.boxprops.color: "black"
boxplot.whiskerprops.color: "black"
boxplot.capprops.color: "black"
boxplot.flierprops.color: "black"
boxplot.flierprops.markeredgecolor: "black"

# ── Text boxes — mirror the legend, so a text box and a legend match ────────
patch.facecolor: "#F0ECF8"
patch.edgecolor: "#663399"

# ── Colors ──────────────────────────────────────────────────────────────────
# Colorblind-accessible 8-color cycle (roles listed in the header)
axes.prop_cycle: cycler('color', ['663399', 'FF8C00', '008080', 'FA8072', '483D8B', 'CD5C5C', '8B0000', '000000'])
image.cmap: viridis
# Black text
text.color: "black"
axes.labelcolor: "black"
xtick.color: "black"
ytick.color: "black"
