# blueprint — deep navy background with white/ice-blue lines,
# evoking technical engineering drawings and CAD blueprints.
#
# Palette:
#   F0F4F8  near-white      — primary drafting line
#   7EC8E3  ice blue        — secondary
#   A3D9FF  pale sky        — tertiary
#   4FA3C5  steel blue
#   C8E6F5  frost
#   60B0D4  cyan-steel
#
# Background: deep navy #0D1F3C — blueprint paper.
#
# Every komorebi_mpl style declares the same parameters in the same section
# order; only the values differ.

# ── Fonts ───────────────────────────────────────────────────────────────────
# font.size is the base; the slots below are deliberately smaller so legends,
# labels, ticks and annotations don't overwhelm the data. Free-floating text
# boxes have no rcParam of their own, so code should use matplotlib *relative*
# sizes ('small', 'x-small', ...) — fractions of this base, so they follow the
# style too.
font.size: 30
axes.titlesize: 28
axes.labelsize: 26
xtick.labelsize: 22
ytick.labelsize: 22
legend.fontsize: 20
figure.titlesize: 30
font.family: sans-serif
font.sans-serif: sans-serif, Arial, Liberation Sans, DejaVu Sans, Bitstream Vera Sans

# ── Figure ──────────────────────────────────────────────────────────────────
figure.figsize: 16, 10
figure.frameon: False
figure.subplot.top: 0.94
figure.subplot.right: 0.93
figure.facecolor: "#0D1F3C"
savefig.facecolor: "#0D1F3C"
# figure.dpi: 100
# savefig.dpi: 300
# savefig.bbox: tight

# ── Axes ────────────────────────────────────────────────────────────────────
axes.facecolor: "#0D1F3C"
axes.edgecolor: "#3A6186"
axes.linewidth: 1.5
axes.titlepad: 12
axes.labelpad: 8
axes.spines.top: True
axes.spines.right: True
axes.grid: True
axes.grid.which: both

# ── Ticks ───────────────────────────────────────────────────────────────────
xtick.top: True
ytick.right: True
xtick.direction: in
ytick.direction: in
xtick.minor.visible: True
ytick.minor.visible: True
xtick.major.size: 10
ytick.major.size: 10
xtick.major.width: 2
ytick.major.width: 2
xtick.minor.size: 5
ytick.minor.size: 5
xtick.minor.width: 1.2
ytick.minor.width: 1.2

# ── Grid — subtle, slightly lighter than the background ─────────────────────
grid.color: "#3A6186"
grid.linestyle: -
grid.linewidth: 0.8
grid.alpha: 0.35

# ── Legend ──────────────────────────────────────────────────────────────────
legend.frameon: True
legend.framealpha: 0.9
legend.facecolor: "#142848"
legend.edgecolor: "#3A6186"
legend.numpoints: 1
legend.scatterpoints: 1
legend.labelspacing: 0.3

# ── Lines & markers ─────────────────────────────────────────────────────────
lines.linewidth: 2
lines.markersize: 6
lines.solid_capstyle: round
errorbar.capsize: 4

# ── Box plots ─ matplotlib defaults these to literal black, which is
# invisible on the dark styles; median/mean already follow the cycle (C1/C2)
boxplot.boxprops.color: "#B8D4EA"
boxplot.whiskerprops.color: "#B8D4EA"
boxplot.capprops.color: "#B8D4EA"
boxplot.flierprops.color: "#B8D4EA"
boxplot.flierprops.markeredgecolor: "#B8D4EA"

# ── Text boxes — mirror the legend, so a text box and a legend match ────────
patch.facecolor: "#142848"
patch.edgecolor: "#3A6186"

# ── Colors ──────────────────────────────────────────────────────────────────
# Ice-blue to white palette — all legible on deep navy
axes.prop_cycle: cycler('color', ['F0F4F8', '7EC8E3', 'A3D9FF', '4FA3C5', 'C8E6F5', '60B0D4'])
image.cmap: Blues
# Light text on dark background
text.color: "#E8F1FA"
axes.labelcolor: "#E8F1FA"
xtick.color: "#B8D4EA"
ytick.color: "#B8D4EA"
